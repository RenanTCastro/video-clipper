# Claude — escolhe os melhores momentos
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Transcrição (Whisper). Funciona com OpenAI ou qualquer API compatível.
# OpenAI:
TRANSCRIBE_API_KEY=sk-...
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
# Groq (bem mais barato e rápido) — descomente para usar:
# TRANSCRIBE_API_KEY=gsk_...
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3

# Local (whisper.cpp, grátis) — descomente e rode ./start-whisper.sh em outro terminal:
# TRANSCRIBE_API_KEY=local
# TRANSCRIBE_BASE_URL=http://localhost:8178/v1
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_CONCURRENCY=1

# Segundos que cada corte começa ANTES do momento escolhido pela IA (para mostrar a jogada). 0 desliga.
PRE_ROLL=25

# Idioma da live (ajuda a precisão)
LANGUAGE=pt

# yt-dlp: argumentos extras (ex.: login do YouTube)
# YTDLP_ARGS=--cookies-from-browser chrome
