# Claude — escolhe os melhores momentos
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Transcrição (Whisper): escolha UM provedor ----
#  local  = grátis, roda no seu PC (precisa instalar o modelo; veja README). Recomendado se tiver GPU/PC bom
#  groq   = nuvem, o mais barato e rápido (~US$ 0,04/hora de áudio). Chave em https://console.groq.com/keys  <- indicado
#  openai = nuvem, mais caro (~US$ 0,36/hora). Chave em https://platform.openai.com/api-keys
TRANSCRIBE_PROVIDER=local

# Preencha só a chave do provedor escolhido:
GROQ_API_KEY=
OPENAI_API_KEY=

# Opcionais (sobrescrevem o padrão do provedor):
# TRANSCRIBE_MODEL=whisper-large-v3
# TRANSCRIBE_CONCURRENCY=1

# Segundos que cada corte começa ANTES do momento escolhido pela IA (para mostrar a jogada). 0 desliga.
PRE_ROLL=25

# Idioma da live (ajuda a precisão)
LANGUAGE=pt

# yt-dlp: argumentos extras (ex.: login do YouTube)
# YTDLP_ARGS=--cookies-from-browser chrome
